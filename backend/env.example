# SQLite est un fichier local, créé automatiquement par l'API.
DB_FILE=data/capteurs.sqlite
PORT=8001

# Le Raspberry doit envoyer cette valeur dans l'en-tête X-API-Key.
API_KEY=remplace-par-une-cle-secrete

# Adresse locale habituelle d'un projet React avec Vite.
FRONTEND_ORIGINS=http://localhost:5173
