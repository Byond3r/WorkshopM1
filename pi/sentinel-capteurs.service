[Unit]
Description=Sentinel-X - capteurs du Pi (mouvement PIR, proximite IR, son)
After=sentinel.service
Wants=sentinel.service

[Service]
# Utilisateur simple, membre du groupe gpio : pas besoin de root pour lire les broches
User=user
WorkingDirectory=/home/user/sentinel
# -u : affichage immédiat dans journalctl (sinon Python garde les lignes en mémoire tampon)
ExecStart=/usr/bin/python3 -u /home/user/sentinel/capteurs_pi.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
