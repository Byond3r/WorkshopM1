[Unit]
Description=Sentinel-X - serveur Flask (API + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
# Utilisateur simple (pas root) : si le serveur web est piraté, l'attaquant n'a pas les droits admin
User=user
WorkingDirectory=/home/user/sentinel
ExecStart=/usr/bin/python3 /home/user/sentinel/serveur.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
